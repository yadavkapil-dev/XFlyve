# Copy to .env and fill in real values. Never commit the real .env file.

# --- Required ---
MONGO_URI=
JWT_SECRET=

# --- Required in production (optional for local development) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# At least one of these is required in production for CORS to allow your frontend.
CORS_WHITELIST=
FRONTEND_URL=

# --- Optional ---
PORT=3001
NODE_ENV=development
# error | warn | info | http | verbose | debug | silly (defaults to "info")
LOG_LEVEL=info

# --- Optional: error monitoring (Sentry) ---
# Leave unset to disable Sentry entirely; the app works normally without it.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
